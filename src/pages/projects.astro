---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/shared/Navbar.astro';
import Footer from '../components/shared/Footer.astro';
import ProjectsHeader from '../components/projects/ProjectsHeader.astro';
import ProjectGrid from '../components/projects/ProjectGrid.astro';
import LoadMoreButton from '../components/projects/LoadMoreButton.astro';
import { projects } from '../data/projects';
---

<Layout title="Portfolio | 3rd Person Creative" description="Explore 3rd Person Creative's work in brand identity, packaging, place branding, events, illustration, and digital design.">
  <Navbar />
  <main class="flex-1 max-w-[1440px] mx-auto w-full px-6 md:px-10 pt-24 pb-12">
    <ProjectsHeader />
    <ProjectGrid />
    {projects.length > 9 && <LoadMoreButton />}
  </main>
  <Footer />
</Layout>
