---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/shared/Navbar.astro';
import AboutHero from '../components/about/AboutHero.astro';
import StatsRibbon from '../components/about/StatsRibbon.astro';
import PhilosophyHistory from '../components/about/PhilosophyHistory.astro';
import TeamSection from '../components/about/TeamSection.astro';
import Callout from '../components/shared/Callout.astro';
import ProcessSection from '../components/shared/ProcessSection.astro';
import Footer from '../components/shared/Footer.astro';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('Missing About page content: src/content/pages/about.md');
const { title, sections } = about.data;

// Only registered, schema-validated section types can be rendered from content.
const sectionComponents = {
  aboutHero: AboutHero,
  statsRibbon: StatsRibbon,
  philosophyHistory: PhilosophyHistory,
  team: TeamSection,
  process: ProcessSection,
  callout: Callout,
};
---

<Layout title={title}>
  <Navbar />
  <main>
    {sections.map(({ type, ...props }) => {
      const Component = sectionComponents[type];
      return <Component {...props} />;
    })}
  </main>
  <Footer />
</Layout>
