---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/shared/Navbar.astro';
import Hero from '../components/home/Hero.astro';
import Callout from '../components/shared/Callout.astro';
import Footer from '../components/shared/Footer.astro';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing Home page content: src/content/pages/home.md');
---

<Layout title={home.data.title}>
  <Navbar />
  <main>
    <Hero />
    {home.data.sections.map(section => {
      if (section.type === 'callout') return <Callout {...section.props} />;
      throw new Error(`Unsupported Home section: ${section.type}`);
    })}
  </main>
  <Footer />
</Layout>
