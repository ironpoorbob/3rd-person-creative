---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/shared/Navbar.astro';
import Footer from '../components/shared/Footer.astro';
import ContactHero from '../components/contact/ContactHero.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import ContactDirect from '../components/contact/ContactDirect.astro';
import SocialLinks from '../components/contact/SocialLinks.astro';
import { contact } from '../data/contact';
import '../styles/contact.css';
---
<Layout title="Let's Talk | 3rd Person Creative" description={contact.description}>
  <Navbar />
  <main class="contact-page">
    <ContactHero />
    <div class="site-content contact-columns">
      <ContactForm />
      <aside aria-label="Contact details">
        <ContactDirect />
        <SocialLinks />
      </aside>
    </div>
  </main>
  <Footer />
</Layout>
