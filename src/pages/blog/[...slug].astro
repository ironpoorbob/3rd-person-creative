---
// src/pages/blog/[...slug].astro
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import BlogPostHero from '../../components/blog/BlogPostHero.astro';
import BlogMeta from '../../components/blog/BlogMeta.astro';
import BlogContent from '../../components/blog/BlogContent.astro';
import BlogPostFooter from '../../components/blog/BlogPostFooter.astro';
import BlogRelated from '../../components/blog/BlogRelated.astro';
import { getReadingTime } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);

// Calculate reading time
const readingTime = getReadingTime(post.body || '');

// Get all posts for related section
const allPosts = await getCollection('blog');
---

<BlogLayout 
  title={post.data.title} 
  description={post.data.description}
  image={typeof post.data.heroImage === 'string' ? post.data.heroImage : post.data.heroImage?.src}
>
  <!-- HERO -->
  <BlogPostHero
    title={post.data.title}
    description={post.data.description}
    heroImage={post.data.heroImage}
    pubDate={post.data.pubDate}
    author={post.data.author}
    tags={post.data.tags}
    content={post.body}
  />

  <!-- ARTICLE CONTENT -->
  <main class="py-16 md:py-24">
    <article class="max-w-[800px] mx-auto px-6">
      <!-- Meta -->
      <BlogMeta
        author={post.data.author}
        pubDate={post.data.pubDate}
        updatedDate={post.data.updatedDate}
        tags={post.data.tags}
        readingTime={readingTime}
        class="mb-12"
      />

      <!-- Content -->
      <BlogContent>
        <Content />
      </BlogContent>

      <!-- Footer: Share & Tags -->
      <BlogPostFooter 
        title={post.data.title}
        tags={post.data.tags || []}
      />
    </article>
  </main>

  <!-- RELATED POSTS -->
  <BlogRelated 
    currentPost={post}
    allPosts={allPosts}
    limit={3}
    title="Related Articles"
  />
</BlogLayout>