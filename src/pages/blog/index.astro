---
// src/pages/blog/index.astro
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import BlogFeaturedPost from '../../components/blog/BlogFeaturedPost.astro';
import BlogHeader from '../../components/blog/BlogHeader.astro';
import BlogGrid from '../../components/blog/BlogGrid.astro';
import BlogPagination from '../../components/blog/BlogPagination.astro';
import BlogNewsletter from '../../components/blog/BlogNewsletter.astro';
import { BLOG_TITLE, BLOG_DESCRIPTION, POSTS_PER_PAGE } from '../../consts';

// Get all blog posts
const allPosts = await getCollection('blog');

// Sort by date (newest first)
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Get featured post
const featuredPost = posts.length > 0 
  ? (posts.find(post => post.data.featured) || posts[0])
  : null;

// Get regular posts (excluding featured)
const regularPosts = featuredPost 
  ? posts.filter(post => post.id !== featuredPost.id)
  : posts;

// Pagination
const paginatedPosts = regularPosts.slice(0, POSTS_PER_PAGE);
const totalPosts = regularPosts.length;
const currentPage = 1; // Will be dynamic when implementing pagination
---

<BlogLayout title={BLOG_TITLE} description={BLOG_DESCRIPTION}>
  <!-- FEATURED POST -->
  {featuredPost && (
    <BlogFeaturedPost post={featuredPost} />
  )}

  <!-- BLOG GRID -->
  <section class="max-w-7xl mx-auto px-6 py-16 md:py-24">
    <!-- Header -->
    <BlogHeader 
      title="Latest Perspectives"
      showFilters={true}
      activeCategory="All posts"
      class="mb-12"
    />

    <!-- Grid -->
    <BlogGrid posts={paginatedPosts} />

    <!-- Pagination -->
    {totalPosts > POSTS_PER_PAGE && (
      <BlogPagination
        totalPosts={totalPosts}
        postsPerPage={POSTS_PER_PAGE}
        currentPage={currentPage}
        baseUrl="/blog"
        class="mt-16 pt-12 border-t border-slate-200 dark:border-slate-800"
      />
    )}
  </section>

  <!-- NEWSLETTER -->
  <BlogNewsletter />
</BlogLayout>