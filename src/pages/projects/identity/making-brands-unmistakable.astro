---
import HeroCarousel from '../../../components/projects/HeroCarousel.astro';
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/shared/Navbar.astro';
import Footer from '../../../components/shared/Footer.astro';
import { projects } from '../../../data/projects';
import { withBase } from '../../../utils/paths';

const project = projects.find(project => project.caseStudyHref === '/projects/identity/making-brands-unmistakable/');
if (!project?.caseStudy || !project.teaser) throw new Error('Identity case-study content is missing.');
const images = project.teaser.images ?? [{ src: project.image, alt: project.alt }];
---

<Layout title={`${project.title} | 3rd Person Creative`} description={project.teaser.description}>
  <Navbar />
  <main class="case-study">
    <article class="site-content">
      <header>
        <a class="back-link" href={withBase('/projects/')}><span aria-hidden="true">←</span> All projects</a>
        <p class="eyebrow">{project.category}</p>
        <h1>{project.title}</h1>
        <p class="subheadline">{project.caseStudy.subheadline}</p>
      </header>
      <HeroCarousel images={images} label="Identity project images" />
      <section class="story" aria-label="About the work">
        <p>{project.teaser.description}</p>
      </section>
      <a class="back-link closing-link" href={withBase('/projects/')}><span aria-hidden="true">←</span> All projects</a>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .case-study {
    background: var(--color-brand-paper);
    color: var(--color-brand-ink);
    font-family: var(--font-body);
    padding: 140px 0 80px;
  }
  header { padding-bottom: clamp(32px, 5vw, 64px); }
  .back-link { display: inline-flex; gap: 10px; align-items: center; font-size: 16px; text-decoration: underline; text-underline-offset: 5px; }
  .back-link:focus-visible { outline: 2px solid currentColor; outline-offset: 6px; }
  .eyebrow { margin: 44px 0 20px; font-size: 14px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  h1 { max-width: 1100px; font-family: var(--font-heading); font-size: clamp(38px, 6vw, 84px); font-weight: 800; line-height: 1.08; letter-spacing: -.055em; }
  .subheadline { margin-top: 24px; font-size: clamp(20px, 2.5vw, 30px); line-height: 1.5; color: var(--color-brand-muted); }
  .story { max-width: 960px; margin: 0 auto; padding: clamp(36px, 6vw, 80px) 0; }
  .story p { font-size: clamp(20px, 2.2vw, 28px); line-height: 1.65; }
  .closing-link { margin-top: 48px; }
  @media (max-width: 600px) { .case-study { padding-top: 116px; padding-bottom: 48px; } .eyebrow { margin-top: 32px; } }
</style>
