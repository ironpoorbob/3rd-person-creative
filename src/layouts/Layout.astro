---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { withBase } from '../utils/paths';
import Favicons from '../components/shared/Favicons.astro';
import BrandFonts from '../components/shared/BrandFonts.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;

const fonts = [400, 500, 600, 700, 900].map(weight => ({
  weight,
  url: withBase(`/fonts/inter-latin-${weight}-normal.woff2`),
}));

// Public font URLs are final deployment URLs, not assets for Vite to resolve.
const fontFaces = fonts.map(({ weight, url }) => `
  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: ${weight};
    font-display: swap;
    src: url(${JSON.stringify(url)}) format('woff2');
  }
`).join('');
---

<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <Favicons />
    <BrandFonts />
    
    <!-- Font preloads and declarations share the same base-aware URLs. -->
    {fonts.map(({ url }) => (
      <link rel="preload" href={url} as="font" type="font/woff2" crossorigin="anonymous" />
    ))}
    <style is:inline set:html={fontFaces} />

    <!-- Inline critical CSS (minimal) -->
    <style>
      /* System font fallback */
      body {
        font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      }
      
    </style>
  </head>
  <body class="bg-white dark:bg-background-dark text-slate-900 dark:text-slate-100 font-display transition-colors duration-300">
    <slot />
  </body>
</html>
