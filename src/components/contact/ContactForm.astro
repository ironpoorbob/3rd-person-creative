---
import { contact } from '../../data/contact';
---
<section class="contact-form" aria-labelledby="inquiry-heading">
  <h2 id="inquiry-heading">Tell us about your project</h2>
  <email-inquiry>
  <form class="contact-fields" action={`mailto:${contact.email}`} method="post" enctype="text/plain">
    <div class="contact-field-row">
      <div class="contact-field">
        <label for="contact-name">Full name</label>
        <input id="contact-name" name="name" autocomplete="name" placeholder="Your name" required />
      </div>
      <div class="contact-field">
        <label for="contact-email">Email address</label>
        <input id="contact-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
      </div>
    </div>
    <div class="contact-field">
      <label for="contact-type">Project type</label>
      <select id="contact-type" name="projectType">
        <option value="">Choose a project type</option>
        {contact.projectTypes.map(type => <option value={type}>{type}</option>)}
      </select>
    </div>
    <div class="contact-field">
      <label for="contact-message">Message</label>
      <textarea id="contact-message" name="message" rows="6" placeholder="Tell us about your idea, goals, and timeline..." required></textarea>
    </div>
    <p id="contact-form-note" class="contact-note">This opens your email app with your project details. Review the email and click Send there. You can also email <a href={`mailto:${contact.email}`}>{contact.email}</a> directly.</p>
    <button type="submit" aria-describedby="contact-form-note">Send inquiry <span aria-hidden="true">→</span></button>
  </form>
  </email-inquiry>
</section>

<script>
  class EmailInquiry extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      const form = this.querySelector('form')!;
      const controller = new AbortController();
      form.addEventListener('submit', event => {
        event.preventDefault();
        const data = new FormData(form);
        const field = (name: string) => String(data.get(name) ?? '').trim();
        const projectType = field('projectType') || 'General inquiry';
        const subject = `Project inquiry: ${projectType}`;
        const body = [
          `Name: ${field('name')}`,
          `Email: ${field('email')}`,
          `Project type: ${projectType}`,
          '',
          field('message'),
        ].join('\r\n');
        const link = document.createElement('a');
        link.href = `${form.action}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        link.click();
      }, { signal: controller.signal });
      this.cleanup = () => controller.abort();
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('email-inquiry')) customElements.define('email-inquiry', EmailInquiry);
</script>
