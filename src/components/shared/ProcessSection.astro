---
import ProcessStep, { type Props as Step } from './ProcessStep.astro';

export interface Props {
  eyebrow: string;
  headline: string;
  subsections: Step[];
  id?: string;
  colorMode?: 'orange' | 'light' | 'dark';
}

const { eyebrow, headline, subsections, id, colorMode = 'light' } = Astro.props;
---

<section class="process-section brand-section" data-color-mode={colorMode} id={id} aria-label={headline}>
  <div class="process-inner">
    <p class="process-eyebrow">{eyebrow}</p>
    <h2>{headline}</h2>
    <ol class="process-grid">
      {subsections.map(step => <ProcessStep {...step} />)}
    </ol>
  </div>
</section>

<style>
  .process-section {
    background: var(--section-background);
    color: var(--section-text);
    font-family: var(--font-body);
    scroll-margin-top: 5rem;
  }

  .process-inner {
    width: min(1380px, 91%);
    margin-inline: auto;
    padding-block: 60px;
    border-bottom: 1px solid var(--section-line);
  }

  .process-eyebrow {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .process-section h2 {
    margin: 26px 0 0;
    font: 700 clamp(30px, 3.7vw, 54px)/1.12 var(--font-heading);
    letter-spacing: -0.065em;
    white-space: pre-line;
    overflow-wrap: break-word;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 18px;
    margin: 34px 0 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 1023px) {
    .process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px;
    }
  }

  @media (max-width: 700px) {
    .process-inner { padding-block: 55px; }
  }

  @media (max-width: 450px) {
    .process-inner { width: calc(100% - 40px); }
    .process-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
