---
import { withBase } from '../../utils/paths';

const navLinks = [
  { label: 'Approach', href: withBase('/#approach') },
  { label: 'Services', href: withBase('/#services') },
  { label: 'People', href: withBase('/#people') },
  { label: 'About', href: withBase('/about/') },
  { label: "Let's talk", href: "mailto:hello@3rdpersoncreative.com?subject=Let's%20talk" },
];

---

<header data-site-header class="fixed top-0 w-full z-50 bg-white/90 dark:bg-background-dark/90 backdrop-blur-md">
  <mobile-navigation>
  <div class="site-content nav-inner h-20 flex items-center justify-between">
    <!-- Logo -->
    <a href={withBase('/')} class="wordmark dark:text-slate-100" aria-label="3rd Person Creative home">
      3rd person <span>creative.</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav hidden lg:flex text-brand-ink dark:text-slate-100" aria-label="Primary navigation">
      {navLinks.map(({ label, href }) => (
        <a class="inline-flex items-center" href={href}>
          <span>{label}</span>
          <svg width="14" height="14" style="flex: 0 0 14px; width: 14px; height: 14px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.8" aria-hidden="true" focusable="false">
            <path d="M4 20 20 4M15 4h5v5" />
          </svg>
        </a>
      ))}
    </nav>

    <!-- Mobile menu button -->
    <button type="button" class="menu-toggle lg:hidden p-2 text-slate-600 dark:text-slate-400" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
      <span class="menu-icon" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </button>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>
    <div class="site-content mobile-links">
      {navLinks.map(({ label, href }) => (
        <a href={href}>
          <span>{label}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true" focusable="false"><path d="M4 20 20 4M15 4h5v5" /></svg>
        </a>
      ))}
    </div>
  </nav>
  </mobile-navigation>
</header>

<script>
  class MobileNavigation extends HTMLElement {
    connectedCallback() {
      const toggle = this.querySelector<HTMLButtonElement>('.menu-toggle')!;
      const menu = this.querySelector<HTMLElement>('.mobile-nav')!;
      const desktop = window.matchMedia('(min-width: 1024px)');
      const controller = new AbortController();
      this.cleanup = () => controller.abort();
      const { signal } = controller;
      const setOpen = (open: boolean) => {
        menu.hidden = !open;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      };
      toggle.addEventListener('click', () => setOpen(menu.hidden), { signal });
      menu.addEventListener('click', event => {
        if (event.target instanceof Element && event.target.closest('a')) {
          setOpen(false);
          toggle.focus();
        }
      }, { signal });
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && !menu.hidden) {
          setOpen(false);
          toggle.focus();
        }
      }, { signal });
      document.addEventListener('pointerdown', event => {
        if (event.target instanceof Node && !this.contains(event.target)) setOpen(false);
      }, { signal });
      this.addEventListener('focusout', event => {
        if (event.relatedTarget instanceof Node && !this.contains(event.relatedTarget)) setOpen(false);
      }, { signal });
      desktop.addEventListener('change', () => {
        if (desktop.matches) {
          if (menu.contains(document.activeElement) || document.activeElement === toggle) {
            this.querySelector<HTMLAnchorElement>('.desktop-nav a')?.focus();
          }
          setOpen(false);
        }
      }, { signal });
      setOpen(false);
    }
    private cleanup?: () => void;
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('mobile-navigation')) customElements.define('mobile-navigation', MobileNavigation);
</script>

<style>
  .desktop-nav {
    align-items: center;
    gap: 0;
    font: 400 16px/1.5 var(--font-body);
    letter-spacing: normal;
    white-space: nowrap;
  }

  .desktop-nav a:hover {
    text-decoration: underline;
  }

  .wordmark {
    color: var(--color-brand-ink);
    font: 800 20px/1 var(--font-heading);
    letter-spacing: -0.07em;
    white-space: nowrap;
  }

  .wordmark span {
    font-weight: 400;
    letter-spacing: -0.045em;
  }

  @media (max-width: 450px) {
    .wordmark {
      font-size: 18px;
    }
  }
</style>
