---
export interface Props {
  number: string;
  headline: string;
  subheadline: string;
}

const { number, headline, subheadline } = Astro.props;
---

<li class="process-step">
  <p class="step-number">{number}</p>
  <h3>{headline}</h3>
  <p class="step-description">{subheadline}</p>
</li>

<style>
  .process-step {
    min-width: 0;
    border-top: 1px solid var(--section-text, var(--color-brand-ink));
    padding-top: 18px;
    font-family: var(--font-body);
    overflow-wrap: break-word;
  }

  .step-number {
    margin: 0;
    color: var(--section-muted, var(--color-brand-muted));
    font-size: 12px;
    line-height: 1.5;
  }

  .process-step h3 {
    margin: 40px 0 12px;
    color: var(--section-text, var(--color-brand-ink));
    font: 700 clamp(20px, 2vw, 29px)/1.15 var(--font-heading);
    letter-spacing: -0.05em;
  }

  .step-description {
    margin: 0;
    color: var(--section-muted, var(--color-brand-muted));
    font-size: 14px;
    line-height: 1.5;
  }
</style>
