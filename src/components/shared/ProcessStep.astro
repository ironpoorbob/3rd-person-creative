---
export interface Props {
  number: string;
  headline: string;
  subheadline: string;
}

const { number, headline, subheadline } = Astro.props;
---

<li class="process-step">
  <p class="step-number">{number}</p>
  <h3>{headline}</h3>
  <p class="step-description">{subheadline}</p>
</li>

<style>
  .process-step {
    min-width: 0;
    border-top: 1px solid #20211e;
    padding-top: 18px;
    font-family: 'DM Sans', Arial, sans-serif;
    overflow-wrap: break-word;
  }

  .step-number {
    margin: 0;
    color: #686963;
    font-size: 12px;
    line-height: 1.5;
  }

  .process-step h3 {
    margin: 40px 0 12px;
    color: #20211e;
    font: 700 clamp(20px, 2vw, 29px)/1.15 'Manrope', sans-serif;
    letter-spacing: -0.05em;
  }

  .step-description {
    margin: 0;
    color: #686963;
    font-size: 14px;
    line-height: 1.5;
  }
</style>
