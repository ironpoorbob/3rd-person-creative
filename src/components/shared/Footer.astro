---
import { footer } from '../../data/footer';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-content footer-inner">
    <p>© {year} {footer.copyrightName}</p>
    <div class="footer-links">
      <a href={footer.socialLink.href} target="_blank" rel="noopener noreferrer" aria-label={footer.socialLink.ariaLabel}>
        {footer.socialLink.label}
        <svg width="14" height="14" style="flex: 0 0 14px; width: 14px; height: 14px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true" focusable="false"><path d="M4 20 20 4M15 4h5v5" /></svg>
      </a>
      <span aria-hidden="true">·</span>
      <p>{footer.tagline}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-brand-paper);
    color: var(--color-brand-muted);
    font: 400 12px/1.5 var(--font-body);
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    padding-block: 40px 55px;
  }
  p { margin: 0; }
  .footer-links { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; }
  a { display: inline-flex; align-items: center; gap: 4px; color: inherit; text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: 4px; }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }
  @media (max-width: 600px) {
    .footer-inner { flex-direction: column; align-items: flex-start; gap: 14px; padding-block: 32px 40px; }
  }
</style>
