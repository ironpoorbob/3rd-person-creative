---
import { withBase } from '../../utils/paths';

export interface Props {
  eyebrow?: string;
  headline: string;
  subheadline?: string;
  linkText: string;
  href: string;
  id?: string;
  colorMode?: 'orange' | 'light' | 'dark';
}

const { eyebrow, headline, subheadline, linkText, href, id, colorMode = 'orange' } = Astro.props;
---

<section class="callout brand-section" data-color-mode={colorMode} id={id} aria-label={headline}>
  <div class="callout-inner">
    {eyebrow && <p class="callout-eyebrow">{eyebrow}</p>}
    <h2>{headline}</h2>
    {subheadline && <p class="callout-subheadline">{subheadline}</p>}
    <a class="callout-link" href={withBase(href)}>
      <span>{linkText}</span>
      <svg width="18" height="18" style="flex: 0 0 18px; width: 18px; height: 18px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true" focusable="false">
        <path d="M4 20 20 4M15 4h5v5" />
      </svg>
    </a>
  </div>
</section>

<style>
  .callout {
    background: var(--section-background);
    color: var(--section-text);
    padding-block: 110px;
    font-family: var(--font-body);
    scroll-margin-top: 5rem;
  }

  .callout-inner {
    width: min(1380px, 91%);
    margin-inline: auto;
  }

  .callout-eyebrow {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .callout h2 {
    max-width: 1000px;
    margin: 28px 0 35px;
    font: 700 clamp(32px, 4.5vw, 70px)/1 var(--font-heading);
    letter-spacing: -0.09em;
    overflow-wrap: break-word;
  }

  .callout-subheadline {
    max-width: 1000px;
    margin: 0 0 20px;
    font-size: 20px;
    line-height: 1.5;
  }

  .callout-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    max-width: 100%;
    padding-block: 10px;
    border-bottom: 2px solid currentColor;
    color: inherit;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .callout-link:hover {
    border-bottom-color: transparent;
  }

  .callout-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 6px;
  }

  @media (max-width: 800px) {
    .callout { padding-block: 85px; }
    .callout h2 { font-size: clamp(30px, 6vw, 47.5px); }
  }

  @media (max-width: 450px) {
    .callout { padding-block: 64px; }
    .callout-inner { width: calc(100% - 40px); }
    .callout h2 { margin-block: 24px; }
    .callout-subheadline { font-size: 18px; }
  }
</style>
