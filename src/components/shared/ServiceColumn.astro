---
export interface Props {
  headline: string;
  tagline: string;
  description: string;
  services: string[];
}

const { headline, tagline, description, services } = Astro.props;
---

<div class="service-column">
  <h3>{headline}</h3>
  <p class="service-tagline">{tagline}</p>
  <p class="service-description">{description}</p>
  <ul>
    {services.map(service => <li>{service}</li>)}
  </ul>
</div>

<style>
  .service-column {
    min-width: 0;
    padding-top: 24px;
    border-top: 1px solid var(--section-text, var(--color-brand-ink));
    color: var(--section-text, var(--color-brand-ink));
    font-family: var(--font-body);
    overflow-wrap: break-word;
  }
  h3 {
    margin: 10px 0 12px;
    font: 700 clamp(28px, 3vw, 46px)/1.1 var(--font-heading);
    letter-spacing: -.06em;
  }
  .service-tagline {
    margin: 0 0 25px;
    font-size: 13px;
    line-height: 1.5;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .service-description { margin: 0; font-size: 19px; line-height: 1.6; }
  ul { margin: 25px 0 0; padding: 0; list-style: none; }
  li { padding-block: 12px; border-bottom: 1px solid var(--section-line, var(--color-brand-line)); font-size: 16px; line-height: 1.5; }
</style>
