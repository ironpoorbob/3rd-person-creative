---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { images: { src: ImageMetadata; alt: string }[]; label: string; }
const { images, label } = Astro.props;
---
<hero-carousel role="region" aria-roledescription="carousel" aria-label={label}>
  <div class="slides">
    {images.map((image, index) => (
      <figure hidden={index !== 0} role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${images.length}`}>
        <Image src={image.src} alt={image.alt} widths={[640, 960, 1380, 1920]} sizes="(max-width: 450px) calc(100vw - 40px), (max-width: 1516px) 91vw, 1380px" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} />
      </figure>
    ))}
  </div>
  {images.length > 1 && <div class="controls">
    <button type="button" data-direction="-1" aria-label="Previous image">←</button>
    <span aria-live="polite" aria-atomic="true">1 / {images.length}</span>
    <button type="button" data-direction="1" aria-label="Next image">→</button>
  </div>}
</hero-carousel>

<script>
  class HeroCarousel extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      const controller = new AbortController();
      const { signal } = controller;
      const slides = [...this.querySelectorAll<HTMLElement>('figure')];
      const count = this.querySelector('[aria-live]');
      let current = 0;
      const show = (index: number) => {
        current = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => { slide.hidden = i !== current; });
        const image = slides[current].querySelector('img');
        if (image) image.loading = 'eager';
        if (count) count.textContent = `${current + 1} / ${slides.length}`;
      };
      this.querySelectorAll<HTMLButtonElement>('[data-direction]').forEach(button => {
        button.addEventListener('click', () => show(current + Number(button.dataset.direction)), { signal });
      });
      this.addEventListener('keydown', event => {
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          event.preventDefault();
          show(current + (event.key === 'ArrowRight' ? 1 : -1));
        }
      }, { signal });
      this.cleanup = () => controller.abort();
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('hero-carousel')) customElements.define('hero-carousel', HeroCarousel);
</script>

<style>
  hero-carousel { display: block; }
  .slides { background: white; aspect-ratio: 16 / 10; }
  figure { margin: 0; width: 100%; height: 100%; }
  figure[hidden] { display: none; }
  img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .controls { display: flex; align-items: center; justify-content: flex-end; gap: 20px; padding-top: 16px; font-size: 16px; }
  button { width: 48px; height: 48px; border: 1px solid var(--color-brand-line); background: transparent; color: inherit; font-size: 26px; cursor: pointer; }
  button:hover { background: var(--color-brand-accent); }
  button:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
</style>
