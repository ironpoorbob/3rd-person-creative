---
// src/components/blog/BlogPostFooter.astro
import BlogShare from './BlogShare.astro';
import BlogTags from './BlogTags.astro';

export interface Props {
  title: string;
  tags: string[];
  className?: string;
}

const { title, tags, className = '' } = Astro.props;
---

<div class={`mt-16 pt-12 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 ${className}`}>
  <BlogShare title={title} />
  <BlogTags tags={tags} />
</div>