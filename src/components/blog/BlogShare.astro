---
// src/components/blog/BlogShare.astro
import Icon from '../shared/Icon.astro';

export interface Props {
  url?: string;
  title?: string;
  className?: string;
}

const { url, title, className = '' } = Astro.props;

const shareUrl = url || Astro.url.href;
const shareTitle = title || 'Check out this article';

// Build share URLs
const getShareLinks = () => ({
  twitter: `https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(shareTitle)}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`,
  email: `mailto:?subject=${encodeURIComponent(shareTitle)}&body=${encodeURIComponent(`Read this: ${shareUrl}`)}`
});

const shareLinks = getShareLinks();
---

<div class={`flex flex-wrap items-center gap-3 ${className}`}>
  <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">
    Share
  </span>
  
  <a
    href={shareLinks.twitter}
    target="_blank"
    rel="noopener noreferrer"
    class="w-10 h-10 flex items-center justify-center rounded-full border border-slate-200 dark:border-slate-800 hover:bg-primary hover:border-primary hover:text-white transition-all"
    aria-label="Share on Twitter"
  >
    <Icon name="brand-twitter" size={18} />
  </a>
  
  <a
    href={shareLinks.linkedin}
    target="_blank"
    rel="noopener noreferrer"
    class="w-10 h-10 flex items-center justify-center rounded-full border border-slate-200 dark:border-slate-800 hover:bg-primary hover:border-primary hover:text-white transition-all"
    aria-label="Share on LinkedIn"
  >
    <Icon name="brand-linkedin" size={18} />
  </a>
  
  <a
    href={shareLinks.facebook}
    target="_blank"
    rel="noopener noreferrer"
    class="w-10 h-10 flex items-center justify-center rounded-full border border-slate-200 dark:border-slate-800 hover:bg-primary hover:border-primary hover:text-white transition-all"
    aria-label="Share on Facebook"
  >
    <Icon name="brand-facebook" size={18} />
  </a>
  
  <a
    href={shareLinks.email}
    class="w-10 h-10 flex items-center justify-center rounded-full border border-slate-200 dark:border-slate-800 hover:bg-primary hover:border-primary hover:text-white transition-all"
    aria-label="Share via Email"
  >
    <Icon name="mail" size={18} />
  </a>
  
  <button
    id="copy-link-button"
    class="w-10 h-10 flex items-center justify-center rounded-full border border-slate-200 dark:border-slate-800 hover:bg-primary hover:border-primary hover:text-white transition-all"
    aria-label="Copy link"
    onclick="navigator.clipboard.writeText(window.location.href); alert('Link copied!');"
  >
    <Icon name="link" size={18} />
  </button>
</div>