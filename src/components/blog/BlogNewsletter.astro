---
// src/components/blog/BlogNewsletter.astro
import Icon from '../shared/Icon.astro';

export interface Props {
  title?: string;
  description?: string;
  className?: string;
}

const { 
  title = 'Stay Refined.',
  description = 'Weekly insights on minimalism, architecture, and the pursuit of essential design delivered to your inbox.',
  className = ''
} = Astro.props;
---

<section class={`bg-slate-900 dark:bg-slate-950 py-16 md:py-24 text-white ${className}`}>
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
    <div>
      <h2 class="text-4xl md:text-5xl font-black tracking-tight leading-tight mb-6">
        {title}
      </h2>
      <p class="text-lg text-slate-400 max-w-sm leading-relaxed">
        {description}
      </p>
    </div>
    <div>
      <form class="flex flex-col gap-6" action="/subscribe" method="POST">
        <div class="relative">
          <input 
            type="email" 
            name="email"
            required
            placeholder="ENTER YOUR EMAIL" 
            class="w-full bg-transparent border-0 border-b-2 border-white/20 focus:border-primary focus:ring-0 text-white py-4 placeholder:text-white/30 uppercase tracking-widest text-sm font-bold transition-all outline-none"
          />
          <button 
            type="submit"
            class="absolute right-0 bottom-4 text-white hover:text-primary transition-colors"
          >
            <Icon name="arrow-right" size={28} />
          </button>
        </div>
        <p class="text-[10px] uppercase tracking-[0.2em] text-white/40">
          By subscribing you agree to our privacy policy.
        </p>
      </form>
    </div>
  </div>
</section>