---
// src/components/blog/BlogPostHero.astro
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { formatDate, getReadingTime, getCategory } from '../../utils/blog';

export interface Props {
  title: string;
  description?: string;
  heroImage: ImageMetadata | string;
  pubDate: Date;
  author?: string;
  tags?: string[];
  content?: string; // For reading time calculation
  category?: string;
}

const {
  title,
  description,
  heroImage,
  pubDate,
  author,
  tags = [],
  content = '',
  category
} = Astro.props;

const readingTime = content ? getReadingTime(content) : undefined;
const displayCategory = category || getCategory(tags);
const displayAuthor = author || 'Studio Alpha';
const formattedDate = formatDate(pubDate, 'long');
---

<div class="relative w-full min-h-[80vh] overflow-hidden group">
  <!-- Hero Image -->
  <div class="absolute inset-0">
    {typeof heroImage === 'string' ? (
      <img
        src={heroImage}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <Image
        src={heroImage}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
        loading="eager"
        fetchpriority="high"
        format="webp"
        fit="cover"
        widths={[640, 1024, 1280, 1600, 1920]}
        sizes="100vw"
        quality={85}
      />
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent" />
  </div>

  <!-- Content -->
  <div class="absolute bottom-0 left-0 right-0 px-6 py-16 md:py-24 max-w-7xl mx-auto">
    <div class="max-w-4xl">
      <!-- Category -->
      <span class="inline-block text-xs font-bold uppercase tracking-[0.2em] text-primary-fixed bg-primary/20 backdrop-blur-sm px-4 py-2 rounded mb-4">
        {displayCategory}
      </span>

      <!-- Title -->
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-black tracking-tight text-white leading-[1.1] mb-6">
        {title}
      </h1>

      <!-- Description -->
      {description && (
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mb-8 leading-relaxed">
          {description}
        </p>
      )}

      <!-- Meta Info -->
      <div class="flex flex-wrap items-center gap-4 text-white/80 text-sm">
        {displayAuthor && (
          <>
            <span class="font-medium text-white">
              {displayAuthor}
            </span>
            <span class="w-1 h-1 bg-white/40 rounded-full"></span>
          </>
        )}
        <time datetime={pubDate.toISOString()}>
          {formattedDate}
        </time>
        {readingTime && (
          <>
            <span class="w-1 h-1 bg-white/40 rounded-full"></span>
            <span>{readingTime} min read</span>
          </>
        )}
        {tags.length > 0 && (
          <>
            <span class="w-1 h-1 bg-white/40 rounded-full"></span>
            <div class="flex flex-wrap gap-2">
              {tags.slice(0, 3).map((tag) => (
                <span key={tag} class="text-[10px] font-bold uppercase tracking-[0.2em] text-white/60">
                  #{tag}
                </span>
              ))}
            </div>
          </>
        )}
      </div>
    </div>
  </div>
</div>