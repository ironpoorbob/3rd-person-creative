---
// src/components/blog/BlogMeta.astro
import { formatDate } from '../../utils/blog';

export interface Props {
  author?: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  readingTime?: number;
  className?: string;
}

const { 
  author, 
  pubDate, 
  updatedDate, 
  tags = [], 
  readingTime,
  className = '' 
} = Astro.props;

const formattedPubDate = formatDate(pubDate, 'long');
const formattedUpdatedDate = updatedDate ? formatDate(updatedDate, 'long') : undefined;
---

<div class={`flex flex-wrap items-center gap-6 border-b border-slate-200 dark:border-slate-800 pb-8 ${className}`}>
  {author && (
    <div class="flex flex-col">
      <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">
        Author
      </span>
      <span class="font-bold text-slate-900 dark:text-white">
        {author}
      </span>
    </div>
  )}
  
  <div class="flex flex-col">
    <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">
      Published
    </span>
    <time datetime={pubDate.toISOString()} class="text-slate-900 dark:text-white">
      {formattedPubDate}
    </time>
  </div>
  
  {formattedUpdatedDate && (
    <div class="flex flex-col">
      <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">
        Updated
      </span>
      <time datetime={updatedDate?.toISOString()} class="text-slate-900 dark:text-white">
        {formattedUpdatedDate}
      </time>
    </div>
  )}
  
  {readingTime && (
    <div class="flex flex-col">
      <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">
        Read Time
      </span>
      <span class="text-slate-900 dark:text-white">
        {readingTime} min read
      </span>
    </div>
  )}
  
  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2 ml-auto">
      {tags.map((tag) => (
        <a
          href={`/blog?tag=${encodeURIComponent(tag)}`}
          class="bg-slate-100 dark:bg-slate-800 px-4 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-slate-600 dark:text-slate-400 rounded hover:bg-primary hover:text-white transition-colors"
          key={tag}
        >
          #{tag}
        </a>
      ))}
    </div>
  )}
</div>