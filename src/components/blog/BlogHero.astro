---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  description: string;
  heroImage: ImageMetadata | string;
  category?: string;
  pubDate?: Date;
  author?: string;
  slug: string;
}

const { title, description, heroImage, category, pubDate, author, slug } = Astro.props;
---

<div class="relative w-full h-[819px] overflow-hidden group">
  <!-- Hero Image -->
  <div class="absolute inset-0">
    <Image
      src={heroImage}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
      loading="eager"
      fetchpriority="high"
      format="webp"
      fit="cover"
      widths={[640, 1024, 1280, 1600, 1920]}
      sizes="100vw"
      quality={85}
    />
  </div>
  
  <!-- Gradient Overlay -->
  <div class="absolute inset-0 bg-gradient-to-t from-on-background/80 via-transparent to-transparent"></div>
  
  <!-- Content -->
  <div class="absolute bottom-0 left-0 w-full px-gutter pb-stack-lg max-w-container-max mx-auto right-0 flex flex-col items-start gap-stack-sm text-on-primary">
    {category && (
      <span class="font-label-caps text-label-caps uppercase text-primary-fixed bg-primary/20 backdrop-blur-sm px-3 py-1 rounded">
        Featured Insight
      </span>
    )}
    
    <h1 class="font-headline-xl text-headline-xl md:max-w-4xl tracking-tighter leading-tight">
      {title}
    </h1>
    
    <p class="font-body-lg text-body-lg max-w-2xl opacity-90">
      {description}
    </p>
    
    <div class="flex items-center gap-4 mt-2">
      {author && (
        <span class="font-body-md">{author}</span>
      )}
      {pubDate && (
        <>
          <span class="w-[1px] h-6 bg-on-primary/30"></span>
          <span class="font-body-md">
            {pubDate.toLocaleDateString('en-US', { 
              year: 'numeric', 
              month: 'short', 
              day: 'numeric' 
            })}
          </span>
        </>
      )}
    </div>
    
    <a 
      href={`/blog/${slug}`}
      class="mt-4 flex items-center gap-2 font-nav-link text-nav-link uppercase tracking-widest hover:translate-x-2 transition-transform duration-300 group"
    >
      Read Article 
      <span class="material-symbols-outlined transition-transform duration-300 group-hover:translate-x-1">arrow_forward</span>
    </a>
  </div>
</div>