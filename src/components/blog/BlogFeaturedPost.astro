---
// src/components/blog/BlogFeaturedPost.astro
import type { CollectionEntry } from 'astro:content';
import { getReadingTime } from '../../utils/blog';

export interface Props {
  post: CollectionEntry<'blog'>;
  className?: string;
}

const { post, className = '' } = Astro.props;
const readingTime = getReadingTime(post.body || '');
---

<section class={`w-full bg-white dark:bg-background-dark border-b border-slate-200 dark:border-slate-800 ${className}`}>
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 min-h-[80vh]">
    <!-- Image Column -->
    <div class="lg:col-span-7 relative overflow-hidden order-2 lg:order-1">
      {typeof post.data.heroImage === 'string' ? (
        <img 
          src={post.data.heroImage}
          alt={post.data.title}
          class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-1000"
        />
      ) : (
        <img 
          src={post.data.heroImage?.src}
          alt={post.data.title}
          class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-1000"
        />
      )}
    </div>
    
    <!-- Content Column -->
    <div class="lg:col-span-5 px-6 py-16 flex flex-col justify-center gap-8 order-1 lg:order-2 bg-surface-light dark:bg-background-dark/50">
      <div class="flex items-center gap-4">
        <span class="h-[1px] w-12 bg-primary"></span>
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-primary">
          Featured Insight
        </span>
      </div>
      
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.1]">
        {post.data.title}
      </h1>
      
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-md">
        {post.data.description}
      </p>
      
      <div class="flex flex-col gap-4 mt-4">
        <div class="flex items-center gap-4 text-xs font-bold tracking-[0.2em] text-slate-500 dark:text-slate-400 uppercase">
          <span>Words by {post.data.author || 'Studio Alpha'}</span>
          <span class="w-1 h-1 bg-slate-300 dark:bg-slate-600 rounded-full"></span>
          <span>{readingTime} Min Read</span>
        </div>
        <a 
          href={`/blog/${post.id}`}
          class="inline-flex items-center gap-4 text-sm font-bold uppercase tracking-wider text-primary hover:gap-6 transition-all duration-300 group"
        >
          <span>Read Full Story</span>
          <svg class="w-5 h-5 group-hover:translate-x-2 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>