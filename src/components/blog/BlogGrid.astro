---
// src/components/blog/BlogGrid.astro
import type { CollectionEntry } from 'astro:content';
import BlogCard from './BlogCard.astro';

export interface Props {
  posts: CollectionEntry<'blog'>[];
  featuredPost?: CollectionEntry<'blog'> | null;
  className?: string;
}

const { posts, featuredPost, className = '' } = Astro.props;

// Determine grid layout based on post position
const getGridSpan = (index: number): string => {
  // First post after featured is larger
  if (index === 0) return 'md:col-span-6 lg:col-span-6';
  if (index === 1) return 'md:col-span-6 lg:col-span-3';
  if (index === 2) return 'md:col-span-6 lg:col-span-3';
  if (index === 3) return 'md:col-span-8 lg:col-span-6';
  return 'md:col-span-6 lg:col-span-4';
};

// Determine if a post should show excerpt
const shouldShowExcerpt = (index: number): boolean => {
  return index === 0 || index === 3;
};

// Determine if a post should be larger
const getImageSize = (index: number): 'featured' | 'standard' | 'small' => {
  if (index === 0) return 'featured';
  if (index === 3) return 'featured';
  return 'standard';
};
---

<div class={`grid grid-cols-1 md:grid-cols-12 gap-x-8 gap-y-16 ${className}`}>
  {posts.map((post, index) => {
    const gridSpan = getGridSpan(index);
    const showExcerpt = shouldShowExcerpt(index);
    const imageSize = getImageSize(index);
    
    return (
      <div class={`${gridSpan} group cursor-pointer`}>
        <BlogCard
          title={post.data.title}
          pubDate={post.data.pubDate}
          heroImage={post.data.heroImage}
          tags={post.data.tags}
          author={post.data.author}
          slug={post.id}
          excerpt={showExcerpt ? post.data.description : undefined}
          imageSize={imageSize}
        />
      </div>
    );
  })}
</div>