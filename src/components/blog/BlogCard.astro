---
// src/components/blog/BlogCard.astro
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { formatDate, truncateText } from '../../utils/blog';

export interface Props {
  title: string;
  pubDate: Date;
  heroImage?: ImageMetadata | string;
  tags?: string[];
  author?: string;
  slug: string;
  excerpt?: string;
  imageSize?: 'featured' | 'standard' | 'small';
  featured?: boolean;
}

const { 
  title, 
  pubDate, 
  heroImage, 
  tags, 
  author, 
  slug, 
  excerpt,
  imageSize = 'standard',
  featured = false 
} = Astro.props;

const formattedDate = formatDate(pubDate, 'short');

// Determine image aspect ratio based on size
const getAspectRatio = () => {
  switch (imageSize) {
    case 'featured':
      return 'aspect-[16/9]';
    case 'small':
      return 'aspect-[3/4]';
    default:
      return 'aspect-[4/3]';
  }
};

// Determine title size
const getTitleSize = () => {
  switch (imageSize) {
    case 'featured':
      return 'text-2xl md:text-3xl lg:text-4xl';
    default:
      return 'text-xl';
  }
};
---

<article class={`group ${featured ? 'col-span-full' : ''}`}>
  <a href={`/blog/${slug}`} class="block">
    {heroImage && (
      <div class={`${getAspectRatio()} overflow-hidden bg-slate-100 dark:bg-slate-800 rounded mb-4`}>
        {typeof heroImage === 'string' ? (
          <img
            src={heroImage}
            alt={title}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading={featured ? 'eager' : 'lazy'}
            fetchpriority={featured ? 'high' : 'auto'}
          />
        ) : (
          <Image
            src={heroImage}
            alt={title}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading={featured ? 'eager' : 'lazy'}
            fetchpriority={featured ? 'high' : 'auto'}
            format="webp"
            fit="cover"
            widths={featured ? [800, 1200, 1600] : [400, 600, 800]}
            sizes={featured ? '100vw' : '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw'}
            quality={80}
          />
        )}
      </div>
    )}
    
    <div class="flex flex-col gap-2">
      <div class="flex justify-between items-center">
        {tags?.[0] && (
          <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-primary">
            {tags[0]}
          </span>
        )}
        <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">
          {formattedDate}
        </span>
      </div>
      
      <h3 class={`font-black tracking-tight text-slate-900 dark:text-white group-hover:text-primary transition-colors duration-200 ${getTitleSize()}`}>
        {title}
      </h3>
      
      {excerpt && (
        <p class="text-slate-600 dark:text-slate-400 leading-relaxed mt-2 line-clamp-2 text-sm">
          {truncateText(excerpt, 160)}
        </p>
      )}
      
      {author && (
        <span class="text-sm text-slate-500 dark:text-slate-400 mt-1">
          By {author}
        </span>
      )}
    </div>
  </a>
</article>