---
// src/components/blog/BlogPagination.astro
export interface Props {
  totalPosts: number;
  postsPerPage: number;
  currentPage: number;
  baseUrl?: string;
  className?: string;
}

const { 
  totalPosts, 
  postsPerPage, 
  currentPage, 
  baseUrl = '/blog',
  className = '' 
} = Astro.props;

const totalPages = Math.ceil(totalPosts / postsPerPage);
const hasPrev = currentPage > 1;
const hasNext = currentPage < totalPages;

// Generate page numbers to show
const getPageNumbers = () => {
  const pages: (number | string)[] = [];
  const maxVisible = 5;
  
  if (totalPages <= maxVisible) {
    for (let i = 1; i <= totalPages; i++) {
      pages.push(i);
    }
  } else {
    pages.push(1);
    if (currentPage > 3) pages.push('...');
    
    const start = Math.max(2, currentPage - 1);
    const end = Math.min(totalPages - 1, currentPage + 1);
    
    for (let i = start; i <= end; i++) {
      pages.push(i);
    }
    
    if (currentPage < totalPages - 2) pages.push('...');
    pages.push(totalPages);
  }
  
  return pages;
};

const pageNumbers = getPageNumbers();
const startItem = (currentPage - 1) * postsPerPage + 1;
const endItem = Math.min(currentPage * postsPerPage, totalPosts);
---

<div class={`flex flex-col md:flex-row justify-between items-center gap-8 ${className}`}>
  <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">
    <span>Displaying</span>
    <span class="text-primary font-black">{startItem}–{endItem}</span>
    <span>of</span>
    <span class="text-primary font-black">{totalPosts}</span>
    <span>Insights</span>
  </div>
  
  <nav class="flex items-center gap-2">
    {hasPrev && (
      <a 
        href={currentPage === 2 ? baseUrl : `${baseUrl}/${currentPage - 1}`}
        class="w-12 h-12 border border-slate-200 dark:border-slate-800 flex items-center justify-center text-slate-900 dark:text-white hover:bg-primary hover:text-white transition-all rounded"
        aria-label="Previous page"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </a>
    )}
    
    <div class="flex items-center">
      {pageNumbers.map((page, index) => (
        page === '...' ? (
          <div key={`ellipsis-${index}`} class="w-12 h-12 border-y border-r border-slate-200 dark:border-slate-800 flex items-center justify-center text-slate-400 dark:text-slate-600">
            ...
          </div>
        ) : (
          <a 
            key={page}
            href={page === 1 ? baseUrl : `${baseUrl}/${page}`}
            class:list={[
              'w-12 h-12 border-y border-r border-slate-200 dark:border-slate-800 flex items-center justify-center text-sm font-medium transition-colors',
              page === currentPage
                ? 'bg-primary text-white border-primary'
                : 'text-slate-600 dark:text-slate-400 hover:text-primary',
              index === 0 ? 'rounded-l' : '',
              index === pageNumbers.length - 1 ? 'rounded-r' : ''
            ]}
          >
            {String(page).padStart(2, '0')}
          </a>
        )
      ))}
    </div>
    
    {hasNext && (
      <a 
        href={`${baseUrl}/${currentPage + 1}`}
        class="w-12 h-12 border border-slate-200 dark:border-slate-800 flex items-center justify-center text-slate-900 dark:text-white hover:bg-primary hover:text-white transition-all rounded"
        aria-label="Next page"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    )}
  </nav>
</div>