---
// src/components/blog/BlogFilters.astro
import { BLOG_CATEGORIES } from '../../consts';

export interface Props {
  activeCategory?: string;
  className?: string;
}

const { activeCategory = 'All posts', className = '' } = Astro.props;

const categories = BLOG_CATEGORIES;
---

<div class={`flex flex-wrap gap-2 border-b border-slate-200 dark:border-slate-800 pb-6 ${className}`}>
  {categories.map((category) => (
    <a
      href={`/blog?category=${encodeURIComponent(category)}`}
      class:list={[
        'px-5 py-2 rounded text-sm font-medium transition-all',
        category === activeCategory
          ? 'bg-primary text-white'
          : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800'
      ]}
      key={category}
    >
      {category}
    </a>
  ))}
</div>