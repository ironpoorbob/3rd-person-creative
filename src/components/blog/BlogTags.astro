---
// src/components/blog/BlogTags.astro
export interface Props {
  tags: string[];
  className?: string;
}

const { tags, className = '' } = Astro.props;
---

{tags.length > 0 && (
  <div class={`flex flex-wrap gap-2 ${className}`}>
    {tags.map((tag) => (
      <a
        href={`/blog?tag=${encodeURIComponent(tag)}`}
        class="bg-slate-100 dark:bg-slate-800 px-4 py-2 text-[10px] font-bold uppercase tracking-[0.2em] text-slate-600 dark:text-slate-400 rounded hover:bg-primary hover:text-white transition-colors"
        key={tag}
      >
        #{tag}
      </a>
    ))}
  </div>
)}