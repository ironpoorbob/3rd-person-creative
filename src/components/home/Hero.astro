---
import { Image, getImage } from 'astro:assets';
import heroImage from '../../assets/img/3rdpc_Landing.jpg';
import mobileHeroImage from '../../assets/img/3rdpc_Landing_mobile.jpg';
import heroLogo from '../../assets/img/3rdpc_Landing_LOGO_crop.svg?url';

const mobileHero = await getImage({
  src: mobileHeroImage,
  widths: [384, 640, mobileHeroImage.width],
  quality: 75,
  format: 'webp',
});
---

<section class="relative h-screen w-full flex items-center justify-center overflow-hidden pt-20">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-black/40 z-10" />
    <picture>
      <source
        media="(max-width: 767px)"
        srcset={mobileHero.srcSet.attribute}
        sizes="100vw"
        type="image/webp"
        width={mobileHeroImage.width}
        height={mobileHeroImage.height}
      />
      <Image
        src={heroImage}
        alt="Black-and-white photograph of a person walking past a brick building"
        class="w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
        widths={[640, 1024, 1280, 1600]}
        sizes="100vw"
        quality={75}
        format="webp"
      />
    </picture>
  </div>

  <!-- Content -->
  <div class="relative z-20 w-full text-center px-6">
    <h1 class="mx-auto max-w-2xl md:ml-auto md:mr-4 md:max-w-[29.4rem]">
      <img
        src={heroLogo}
        alt="3rd Person Creative"
        width="463"
        height="167"
        class="block w-full h-auto"
        loading="eager"
      />
    </h1>
  </div>
</section>
